# Copy to .env.local. Only variables starting with VITE_ are visible to the browser (never put secrets here).

# Google Cloud Console > Credentials > OAuth client ID (type: Web application).
# Add http://localhost:5173 under "Authorized JavaScript origins". Must match the server's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Where the API lives. Leave EMPTY to use the same origin as the page: in development Vite proxies /api to
# http://localhost:4000, and on Vercel vercel.json rewrites /api to the API host.
# Set it (e.g. https://api.example.com, no trailing slash) only when the API has its own domain. The server's
# CLIENT_ORIGIN must then include this site, and cookies need both apps on one domain (or COOKIE_SAMESITE=none).
VITE_API_URL=
