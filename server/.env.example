# Copy this file to .env and fill in real values. Never commit .env.

# --- required ---
DB_URL=

# --- server ---
PORT=4000
# The site(s) that open the app in a browser. Several are allowed, comma-separated (for example your Vercel URL and your own domain).
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Reverse proxies in front of the API. Leave empty for the default (1 in production, none locally); a number or "false".
TRUST_PROXY=

# --- sessions (SESSION_SECRET is REQUIRED in production: use a long random string) ---
SESSION_SECRET=
# 'lax' when client and API share a site (or use a dev proxy); 'none' (needs HTTPS) for different sites
COOKIE_SAMESITE=lax

# --- Google sign-in (Google Cloud Console > Credentials > OAuth client ID, type "Web") ---
GOOGLE_CLIENT_ID=
# Comma-separated. These emails become admins when they sign in.
ADMIN_EMAILS=
# Optional bootstrap list (comma-separated) of emails that can always sign in, in addition to admins. Day-to-day, invite people from Admin > Access instead. Production is invite-only even if this is empty.
ALLOWED_EMAILS=

# --- local testing without Google: enables POST /api/v1/auth/dev-login (ignored in production) ---
AUTH_DEV_LOGIN=false

# --- admin playlist import (YouTube Data API v3 key) ---
YOUTUBE_API_KEY=

# --- admin Resources page: "Import from a Drive folder" (Google Drive API key) ---
# Can be the same key as YOUTUBE_API_KEY if that key allows both APIs; leave empty to use the YouTube key.
GOOGLE_DRIVE_API_KEY=
