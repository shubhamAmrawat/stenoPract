# Copy this file to .env and fill in real values. Never commit .env.

# --- required ---
DB_URL=

# --- server ---
PORT=4000
# The site(s) that open the app in a browser. Several are allowed, comma-separated (for example your Vercel URL and your own domain).
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Reverse proxies in front of the API. Leave empty for the default (1 in production, none locally); a number or "false".
TRUST_PROXY=

# --- sessions (SESSION_SECRET is REQUIRED in production: use a long random string) ---
SESSION_SECRET=
# 'lax' when client and API share a site (or use a dev proxy); 'none' (needs HTTPS) for different sites
COOKIE_SAMESITE=lax

# --- Google sign-in (Google Cloud Console > Credentials > OAuth client ID, type "Web") ---
GOOGLE_CLIENT_ID=
# Comma-separated. These emails become admins when they sign in with Google (never with a password). Use your own Google account email.
ADMIN_EMAILS=
# Optional list (comma-separated) of emails that can always sign in, even when an admin switches sign-up to invite-only. Day-to-day, invite people from Admin > Access instead.
ALLOWED_EMAILS=

# --- automated tests only: enables POST /api/v1/auth/dev-login (ignored in production). Leave false; you can sign up with email and password locally instead ---
AUTH_DEV_LOGIN=false

# --- admin playlist import (YouTube Data API v3 key) ---
YOUTUBE_API_KEY=

# --- admin Resources page: "Import from a Drive folder" (Google Drive API key) ---
# Can be the same key as YOUTUBE_API_KEY if that key allows both APIs; leave empty to use the YouTube key.
GOOGLE_DRIVE_API_KEY=

# --- profile photos: Cloudflare R2 bucket. Uploads are enabled only when ALL of these are set ---
# Cloudflare dashboard > R2 > overview shows the account id. (Or set R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com instead.)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Where browsers read the bucket from (the bucket's public r2.dev address, or your own domain). No trailing slash.
R2_PUBLIC_URL=
# Optional. A folder inside the bucket for this app's files (for example steno), so it can share a bucket with another project. Choose it once and keep it: changing it later breaks existing photo links.
R2_KEY_PREFIX=

# --- admin "Add transcripts from scans": Claude reads the scanned book pages. Add this key here AND in Render's environment ---
# Create a key at console.anthropic.com. Never commit it. Without it the scans page shows a clear "not configured" error.
ANTHROPIC_API_KEY=
# Optional. The model that reads the pages (default claude-sonnet-5). Change it when a better one is released.
# SCAN_MODEL=claude-sonnet-5
# Optional. 2 (default) reads every page twice and flags disagreements; 1 halves the cost.
# SCAN_PASSES=2
