    {
      "name": "2. Admin: build content (run in order)",
      "item": [
        {
          "name": "Create set",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/sets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "sets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"kc-24\",\n  \"title\": \"Kailash Chandra Vol 24\",\n  \"source\": \"Kailash Chandra, Vol. 24\",\n  \"published\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('setId', j.set.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List sets",
